# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Public URL where this server is reachable (used for Twilio webhook URLs)
# Use your VPS IP address, e.g. http://123.45.67.89:3000
# Or a domain if you have one, e.g. https://yourdomain.com
PUBLIC_URL=http://YOUR_VPS_IP:3000

# Port for the Flask webhook server
PORT=3000
